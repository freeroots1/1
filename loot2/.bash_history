B64_SERVER

chmod 644 "$SERVER_FILE"
node --check "$SERVER_FILE"
echo "[4/6] 更新小算盘环境配置"
TMP_ENV="$(mktemp)"
base64 -d > "$TMP_ENV" <<'B64_ENV'
WElBT1NVQU5QQU5fQVBJX1RPS0VOPWJjYTZjMGFlNzY1ZDMyODAyN2ZhODE4NzlkMzdlZDdlMjk3
YWM4OTQ2YmIzZDgyOApGRUlTSFVfVkVSSUZJQ0FUSU9OX1RPS0VOPTZmNjNmOWJlNWEwMmUxODcx
NjRkNDQ5Njk0MGZmN2RhCkZFSVNIVV9BUFBfSUQ9Y2xpX2E5N2Y0MWJkYjZmODliYzIKRkVJU0hV
X0FQUF9TRUNSRVQ9c3lpSnVsWFRwMmozSGxPa3IwVUx3Z3JmNW5ZbXFKdWUK
B64_ENV

TMP_EXISTING="$(mktemp)"
if [ -f "$ENV_FILE" ]; then   grep -vE '^(XIAOSUANPAN_API_TOKEN|FEISHU_VERIFICATION_TOKEN|FEISHU_APP_ID|FEISHU_APP_SECRET)=' "$ENV_FILE" > "$TMP_EXISTING" || true; fi
cat "$TMP_EXISTING" > "$ENV_FILE"
for key in XIAOSUANPAN_API_TOKEN FEISHU_VERIFICATION_TOKEN FEISHU_APP_ID FEISHU_APP_SECRET; do   line="$(grep -m1 "^${key}=" "$TMP_ENV" || true)";   if [ -z "$line" ]; then     echo "缺少 $key，请停止。";     exit 1;   fi;   printf '%s\n' "$line" >> "$ENV_FILE"; done
chmod 600 "$ENV_FILE"
rm -f "$TMP_ENV" "$TMP_EXISTING"
echo "[5/6] 重启 dnt-dashboard"
pm2 restart dnt-dashboard --update-env
sleep 3
pm2 list
echo "[6/6] 本机接口验证"
API_TOKEN="$(grep -m1 '^XIAOSUANPAN_API_TOKEN=' "$ENV_FILE" | cut -d= -f2-)"
VERIFY_TOKEN="$(grep -m1 '^FEISHU_VERIFICATION_TOKEN=' "$ENV_FILE" | cut -d= -f2-)"
echo "-- health --"
curl -fsS "http://127.0.0.1:4173/api/finance-xiaosuanpan/health?token=${API_TOKEN}"; echo
printf '{"type":"url_verification","token":"%s","challenge":"codex-ok"}' "$VERIFY_TOKEN" > /tmp/xiaosuanpan-verify.json
echo "-- feishu url verification --"
curl -fsS -X POST "http://127.0.0.1:4173/api/feishu/xiaosuanpan/events" -H 'Content-Type: application/json' --data @/tmp/xiaosuanpan-verify.json; echo
rm -f /tmp/xiaosuanpan-verify.json
echo "部署完成。请把上面 health 和 feishu url verification 两段输出发给 Codex 看。"
# 创建虚拟环境
python3 -m venv .venv
# 升级 pip 并使用阿里云镜像安装依赖
.venv/bin/pip install -U pip -i https://mirrors.aliyun.com/pypi/simple/
.venv/bin/pip install -r requirements.txt -i https://mirrors.aliyun.com/pypi/simple/
cd /opt/nagong-rag/rag_service/
.venv/bin/pip install -r requirements.txt -i https://mirrors.aliyun.com/pypi/simple/
python3 -m venv .venv
.venv/bin/pip install -U pip -i https://mirrors.aliyun.com/pypi/simple/
.venv/bin/pip install -r requirements.txt -i https://mirrors.aliyun.com/pypi/simple/
nohup .venv/bin/python server.py > rag.log 2>&1 &
# 确认进程是否存在
ps aux | grep server.py
# 请求健康检查接口
curl http://127.0.0.1:9203/health
cat rag.log
cat server.py
cat << 'EOF' > server.py
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""RAG 检索服务（FastAPI）

接口：
  GET  /health            健康检查 + 库统计
  POST /search            语义检索（核心）
  POST /search/raw        返回向量+分数（调试用）

启动：
  uvicorn server:app --host 0.0.0.0 --port 9203
  或 python3 server.py
"""
import json
import numpy as np
import faiss
import pyarrow.parquet as pq
from typing import Optional, List
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field
from pathlib import Path
from config import (INDEX_PATH, META_PATH, DEFAULT_TOP_K, OVERFETCH, HOST, PORT)
from embed import embed_one

app = FastAPI(title="纳贡知识库 RAG 检索", version="1.0")

# 全局：索引 + 元数据（启动时加载）
_index = None
_meta = None       # list[dict]
_ids_pos = None    # id -> faiss 位置（用于过滤后定位）


class SearchReq(BaseModel):
    query: str = Field(..., description="用户问题或关键词")
    top_k: int = Field(DEFAULT_TOP_K, ge=1, le=50)
    topic: Optional[str] = Field(None, description="按主题过滤，如 身心觉察")
    source_type: Optional[str] = Field(None, description="video/book/article/note")
    min_confidence: float = Field(0.0, ge=0, le=1)


def _load():
    global _index, _meta
    if not INDEX_PATH.exists() or not META_PATH.exists():
        raise RuntimeError(f"索引未建立: {INDEX_PATH}。请先跑 build_index.py")
    _index = faiss.read_index(str(INDEX_PATH))
    tbl = pq.read_table(META_PATH)
    _meta = tbl.to_pylist()
    print(f"已加载索引: {_index.ntotal} 向量, {len(_meta)} 条元数据")


@app.on_event("startup")
def _startup():
    _load()


@app.get("/health")
def health():
    from collections import Counter
    return {
        "status": "ok",
        "vectors": _index.ntotal if _index else 0,
        "topic_dist": dict(Counter(m["topic"] for m in _meta)) if _meta else {},
    }


@app.post("/search")
def search(req: SearchReq):
    if _index is None:
        raise HTTPException(503, "索引未加载")
    qv = embed_one(req.query).reshape(1, -1)
    # 过量检索，再在 Python 层按 metadata 过滤
    k = min(_index.ntotal, req.top_k * OVERFETCH + 5)
    scores, idx = _index.search(qv, k)
    results = []
    for sc, i in zip(scores[0], idx[0]):
        if i < 0:
            continue
        m = _meta[i]
        if req.topic and m["topic"] != req.topic:
            continue
        if req.source_type and m["source_type"] != req.source_type:
            continue
        if m["confidence"] < req.min_confidence:
            continue
        results.append({
            "id": m["id"], "score": float(sc),
            "topic": m["topic"], "title": m["title"],
            "source": m["source"], "source_type": m["source_type"],
            "timestamp": m["timestamp"], "confidence": m["confidence"],
            "content": m["content"],
        })
        if len(results) >= req.top_k:
            break
    return {"query": req.query, "count": len(results), "results": results}


@app.post("/search/raw")
def search_raw(req: SearchReq):
    """返回纯片段文本（直接拼 prompt 用），按相关性排序。"""
    r = search(req)
    return {
        "query": r["query"],
        "contexts": [x["content"] for x in r["results"]],
        "sources": [{"id": x["id"], "topic": x["topic"],
                     "timestamp": x["timestamp"], "source": x["source"]} for x in r["results"]],
    }


class RagflowReq(BaseModel):
    """兼容小智 search_from_ragflow 插件的请求体(插件发 question/dataset_ids)。"""
    question: str
    dataset_ids: list = Field(default_factory=list)
    top_k: int = DEFAULT_TOP_K


@app.post("/api/v1/retrieval")
def ragflow_compat(req: RagflowReq):
    """兼容 RAGFlow /api/v1/retrieval,供小智插件直接调用,无需改插件代码。
    返回 {code:0, data:{chunks:[{content,...}]}}(RAGFlow 格式)。"""
    r = search(SearchReq(query=req.question, top_k=req.top_k))
    chunks = [{
        "content": x["content"],
        "document_name": x.get("title", ""),
        "document_id": x.get("id", ""),
        "similarity": x.get("score", 0.0),
    } for x in r["results"]]
    return {"code": 0, "message": "ok", "data": {"chunks": chunks}}


if __name__ == "__main__":
    import uvicorn
    uvicorn.run("server:app", host=HOST, port=PORT, reload=False)
EOF

cat << 'EOF' > server.py
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import json
import numpy as np
import faiss
import pyarrow.parquet as pq
from typing import Optional, List
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field
from pathlib import Path
from config import (INDEX_PATH, META_PATH, DEFAULT_TOP_K, OVERFETCH, HOST, PORT)
from embed import embed_one

app = FastAPI(title="纳贡 RAG", version="1.0")
_index = None
_meta = None

class SearchReq(BaseModel):
    query: str = Field(..., description="Query")
    top_k: int = Field(DEFAULT_TOP_K, ge=1, le=50)
    topic: Optional[str] = Field(None, description="Topic filter")
    source_type: Optional[str] = Field(None, description="Source type")
    min_confidence: float = Field(0.0, ge=0, le=1)

def _load():
    global _index, _meta
    if not INDEX_PATH.exists() or not META_PATH.exists():
        raise RuntimeError(f"Index not found: {INDEX_PATH}")
    _index = faiss.read_index(str(INDEX_PATH))
    tbl = pq.read_table(META_PATH)
    _meta = tbl.to_pylist()
    print(f"Loaded: {_index.ntotal} vectors, {len(_meta)} rows")

@app.on_event("startup")
def _startup():
    _load()

@app.get("/health")
def health():
    from collections import Counter
    res = {"status": "ok", "vectors": 0, "topic_dist": {}}
    if _index and _meta:
        res["vectors"] = _index.ntotal
        res["topic_dist"] = dict(Counter(m["topic"] for m in _meta))
    return res

@app.post("/search")
def search(req: SearchReq):
    if _index is None:
        raise HTTPException(503, "Index not loaded")
    qv = embed_one(req.query).reshape(1, -1)
    k = min(_index.ntotal, req.top_k * OVERFETCH + 5)
    scores, idx = _index.search(qv, k)
    results = []
    for sc, i in zip(scores[0], idx[0]):
        if i < 0:
            continue
        m = _meta[i]
        if req.topic and m["topic"] != req.topic:
            continue
        if req.source_type and m["source_type"] != req.source_type:
            continue
        if m["confidence"] < req.min_confidence:
            continue
        results.append({
            "id": m["id"], "score": float(sc),
            "topic": m["topic"], "title": m["title"],
            "source": m["source"], "source_type": m["source_type"],
            "timestamp": m["timestamp"], "confidence": m["confidence"],
            "content": m["content"],
        })
        if len(results) >= req.top_k:
            break
    return {"query": req.query, "count": len(results), "results": results}

@app.post("/search/raw")
def search_raw(req: SearchReq):
    r = search(req)
    return {
        "query": r["query"],
        "contexts": [x["content"] for x in r["results"]],
        "sources": [{"id": x["id"], "topic": x["topic"],
                     "timestamp": x["timestamp"], "source": x["source"]} for x in r["results"]],
    }

class RagflowReq(BaseModel):
    question: str
    dataset_ids: list = Field(default_factory=list)
    top_k: int = DEFAULT_TOP_K

@app.post("/api/v1/retrieval")
def ragflow_compat(req: RagflowReq):
    r = search(SearchReq(query=req.question, top_k=req.top_k))
    chunks = [{
        "content": x["content"],
        "document_name": x.get("title", ""),
        "document_id": x.get("id", ""),
        "similarity": x.get("score", 0.0),
    } for x in r["results"]]
    return {"code": 0, "message": "ok", "data": {"chunks": chunks}}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run("server:app", host=HOST, port=PORT, reload=False)
EOF

