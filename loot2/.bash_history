import json, subprocess, sqlite3
L='/root/.nvm/versions/node/v20.20.2/bin/lark-cli'
def api(path, params):
 r=subprocess.run([L,'api','GET',path,'--as','bot','--params',json.dumps(params)],capture_output=True,text=True)
 return json.loads(r.stdout)
s=api('/open-apis/contact/v3/scopes',{'page_size':100,'department_id_type':'open_department_id','user_id_type':'open_id'})
ids=s.get('data',{}).get('user_ids',[]) or []
db=sqlite3.connect('/home/pangchao/metabot/data/hr.db')
names={r[0] for r in db.execute('select name from hr_employees')}
out=[]
for uid in ids:
 x=api('/open-apis/contact/v3/users/'+uid,{'user_id_type':'open_id','department_id_type':'open_department_id'})
 u=x.get('data',{}).get('user',{})
 st=u.get('status') or {}
 out.append({'name':u.get('name'),'job_title':u.get('job_title') or '', 'status':'离职' if st.get('is_resigned') else '在职' if st.get('is_activated') else '其他', 'department_count':len(u.get('department_ids') or []), 'already_in_hr':u.get('name') in names})
print(json.dumps({'direct_authorized_users':len(ids),'people':out},ensure_ascii=False,indent=2))
