const fs=require('fs');
const cfg=JSON.parse(fs.readFileSync('/home/pangchao/metabot/bots.json','utf8')).feishuBots.find(x=>x.name==='人事');
const base='https://open.feishu.cn/open-apis';
async function getToken(){const r=await fetch(base+'/auth/v3/tenant_access_token/internal',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({app_id:cfg.feishuAppId,app_secret:cfg.feishuAppSecret})});const x=await r.json();if(x.code!==0)throw new Error(`auth ${x.code} ${x.msg}`);return x.tenant_access_token;}
(async()=>{const token=await getToken();const headers={authorization:`Bearer ${token}`};async function pages(path,params){let out=[],pt='';do{if(pt)params.page_token=pt;const u=new URL(base+path);for(const [k,v] of Object.entries(params))u.searchParams.set(k,String(v));const r=await fetch(u,{headers,signal:AbortSignal.timeout(10000)});const x=await r.json();if(x.code!==0)throw new Error(`${path} ${x.code} ${x.msg}`);out.push(...(x.data?.items||[]));pt=x.data?.has_more?x.data.page_token:'';}while(pt);return out;}
const depts=await pages('/contact/v3/departments/0/children',{department_id_type:'open_department_id',user_id_type:'open_id',fetch_child:'true',page_size:50});const deptMap=new Map(depts.map(d=>[d.open_department_id,d.name]));const deptIds=['0',...depts.map(d=>d.open_department_id)];const byId=new Map();const errors=[];for(const id of deptIds){try{const users=await pages('/contact/v3/users/find_by_department',{department_id_type:'open_department_id',user_id_type:'open_id',department_id:id,page_size:50});for(const u of users)byId.set(u.open_id,u);}catch(e){errors.push({department:id==='0'?'根部门':deptMap.get(id)||'未知',error:e.message});}}
const people=[...byId.values()].map(u=>({name:u.name,departments:(u.department_ids||[]).map(x=>deptMap.get(x)||x),status:u.status?.is_resigned?'离职':u.status?.is_frozen?'冻结':u.status?.is_exited?'退出':u.status?.is_unjoin?'未加入':u.status?.is_activated?'在职':'未知',job_title:u.job_title||''})).sort((a,b)=>a.name.localeCompare(b.name,'zh-CN'));console.log(JSON.stringify({source:'飞书通讯录（人事机器人应用身份）',departmentCount:depts.length,total:people.length,people,errors},null,2));})().catch(e=>{console.error(JSON.stringify({fatal:e.message}));process.exitCode=1});
