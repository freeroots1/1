python3 - <<'PY'
import json, subprocess, sqlite3
L='/root/.nvm/versions/node/v20.20.2/bin/lark-cli'; D='/usr/local/bin/dnt'; DB='/home/pangchao/metabot/data/hr.db'
def api(path,params):
 r=subprocess.run([L,'api','GET',path,'--as','bot','--params',json.dumps(params)],capture_output=True,text=True,check=True)
 x=json.loads(r.stdout)
 if x.get('code') not in (None,0): raise RuntimeError(f"Feishu API {x.get('code')}: {x.get('msg')}")
 return x.get('data',{})
db=sqlite3.connect(DB)
# 清理刚才误由 --help 生成的空白记录，仅匹配精确 ID 和空姓名
cur=db.execute("DELETE FROM hr_employees WHERE id=? AND name=''",('emp-1784108630520-dy25zr',))
sc=api('/open-apis/contact/v3/scopes',{'page_size':100,'department_id_type':'open_department_id','user_id_type':'open_id'})
added=[]; existing=[]
for uid in sc.get('user_ids',[]) or []:
 u=api('/open-apis/contact/v3/users/'+uid,{'user_id_type':'open_id','department_id_type':'open_department_id'}).get('user',{})
 name=u.get('name')
 if not name: continue
 row=db.execute('SELECT id FROM hr_employees WHERE name=?',(name,)).fetchone()
 if row:
  db.execute("UPDATE hr_employees SET feishu_open_id=?,status='active' WHERE id=?",(uid,row[0])); existing.append(name); continue
 r=subprocess.run([D,'hr','employee','add','--name',name,'--position','员工','--dept','待确认'],capture_output=True,text=True,encoding='utf-8')
 try: nid=json.loads(r.stdout).get('data',{}).get('id')
 except Exception: nid=None
 if not nid: raise RuntimeError(f'新增{name}失败')
 db.execute("UPDATE hr_employees SET feishu_open_id=?,status='active' WHERE id=?",(uid,nid)); added.append(name)
db.commit()
print(json.dumps({'removed_accidental_blank':cur.rowcount,'added':added,'existing_updated':existing},ensure_ascii=False))
