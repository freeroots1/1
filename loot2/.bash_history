const fs=require('fs'); const cfg=JSON.parse(fs.readFileSync('/home/pangchao/metabot/bots.json','utf8')).feishuBots.find(x=>x.name==='人事'); const base='https://open.feishu.cn/open-apis';
(async()=>{const ar=await fetch(base+'/auth/v3/tenant_access_token/internal',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({app_id:cfg.feishuAppId,app_secret:cfg.feishuAppSecret})});const ax=await ar.json();if(ax.code!==0)throw new Error(`auth ${ax.code} ${ax.msg}`);const headers={authorization:`Bearer ${ax.tenant_access_token}`};async function api(path,params={}){const u=new URL(base+path);for(const[k,v]of Object.entries(params))u.searchParams.set(k,String(v));const r=await fetch(u,{headers,signal:AbortSignal.timeout(10000)});const x=await r.json();if(x.code!==0)throw new Error(`${x.code} ${x.msg}`);return x.data||{};}let deptIds=[],userIds=[],pt='';do{const d=await api('/contact/v3/scopes',{department_id_type:'open_department_id',user_id_type:'open_id',page_size:100,...(pt?{page_token:pt}:{})});deptIds.push(...(d.department_ids||[]));userIds.push(...(d.user_ids||[]));pt=d.has_more?d.page_token:'';}while(pt);const deptMap=new Map(), users=new Map(), errors=[];for(const id of deptIds){try{const d=await api('/contact/v3/departments/'+encodeURIComponent(id),{department_id_type:'open_department_id',user_id_type:'open_id'});const dep=d.department||d;deptMap.set(id,dep.name||'未知部门');}catch(e){errors.push('部门信息读取失败: '+e.message);}let up='';do{try{const d=await api('/contact/v3/users/find_by_department',{department_id_type:'open_department_id',user_id_type:'open_id',department_id:id,page_size:50,...(up?{page_token:up}:{})});for(const u of(d.items||[]))users.set(u.open_id,u);up=d.has_more?d.page_token:'';}catch(e){errors.push('部门成员读取失败: '+e.message);up='';}}while(up);}for(const id of userIds){if(users.has(id))continue;try{const d=await api('/contact/v3/users/'+encodeURIComponent(id),{user_id_type:'open_id',department_id_type:'open_department_id'});const u=d.user||d;users.set(u.open_id||id,u);}catch(e){errors.push('授权成员读取失败: '+e.message);}}
const people=[...users.values()].map(u=>({name:u.name||'',departments:(u.department_ids||[]).map(x=>deptMap.get(x)||'授权范围外部门'),status:u.status?.is_resigned?'离职':u.status?.is_frozen?'冻结':u.status?.is_exited?'退出':u.status?.is_unjoin?'未加入':u.status?.is_activated?'在职':'未知',job_title:u.job_title||''})).sort((a,b)=>a.name.localeCompare(b.name,'zh-CN'));console.log(JSON.stringify({scope:{departmentIds:deptIds.length,directUserIds:userIds.length},visiblePeople:people.length,departments:[...deptMap.values()],people,errors},null,2));})().catch(e=>{console.error(JSON.stringify({fatal:e.message}));process.exitCode=1});
