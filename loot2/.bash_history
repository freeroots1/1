python3 - <<'PY'
import json, subprocess, sqlite3
L='/root/.nvm/versions/node/v20.20.2/bin/lark-cli'; D='/usr/local/bin/dnt'; DB='/home/pangchao/metabot/data/hr.db'
def api(path,params):
 r=subprocess.run([L,'api','GET',path,'--as','bot','--params',json.dumps(params)],capture_output=True,text=True,check=True); x=json.loads(r.stdout)
 if x.get('code') not in (None,0): raise RuntimeError(f"Feishu API {x.get('code')}: {x.get('msg')}")
 return x.get('data',{})
# 先独立提交清理，避免持锁调用 dnt
with sqlite3.connect(DB) as db:
 removed=db.execute("DELETE FROM hr_employees WHERE id=? AND name=''",('emp-1784108630520-dy25zr',)).rowcount
sc=api('/open-apis/contact/v3/scopes',{'page_size':100,'department_id_type':'open_department_id','user_id_type':'open_id'})
people=[]
for uid in sc.get('user_ids',[]) or []:
 u=api('/open-apis/contact/v3/users/'+uid,{'user_id_type':'open_id','department_id_type':'open_department_id'}).get('user',{})
 if u.get('name'): people.append((u['name'],uid))
added=[]; existing=[]
for name,uid in people:
 with sqlite3.connect(DB) as db: row=db.execute('SELECT id FROM hr_employees WHERE name=?',(name,)).fetchone()
 if row: nid=row[0]; existing.append(name)
 else:
  r=subprocess.run([D,'hr','employee','add','--name',name,'--position','员工','--dept','待确认'],capture_output=True,text=True,encoding='utf-8')
  try: nid=json.loads(r.stdout).get('data',{}).get('id')
  except Exception: nid=None
  if not nid: raise RuntimeError(f"新增{name}失败: {(r.stdout+r.stderr)[:200]}")
  added.append(name)
 with sqlite3.connect(DB) as db: db.execute("UPDATE hr_employees SET feishu_open_id=?,status='active' WHERE id=?",(uid,nid))
print(json.dumps({'removed_accidental_blank':removed,'added':added,'existing_updated':existing},ensure_ascii=False))
PY

